# === Qwen (primary LLM) — Alibaba DashScope ===
# Get key: https://dashscope.console.aliyun.com/
QWEN_API_KEY=
# or:
DASHSCOPE_API_KEY=
QWEN_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# === Optional: OpenAI (TTS + fallback script) ===
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TTS_VOICE=onyx
TTS_MODEL=tts-1-hd

# === YouTube (optional until OAuth works) ===
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
