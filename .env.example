# Local self-hosted language model (no Qwen/DashScope or paid LLM API required)
AI_ENGINE=local
LOCAL_LLM_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Free Persian neural voice; local Piper can be configured as fallback.
TTS_PROVIDER=edge
TTS_VOICE=fa-IR-FaridNeural
PIPER_MODEL=

# YouTube OAuth for publishing and channel operations
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
