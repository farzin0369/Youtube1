# Cloud text-generation providers only. No Ollama/local LLM fallback is used.
# Groq is the default for the OpenClaw supervisor and the Python Shorts pipeline.
GROQ_API_KEY=
# Optional OpenClaw-native cloud fallback; may incur API charges.
OPENAI_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENCLAW_MODEL=groq/openai/gpt-oss-20b

# Optional cloud OpenAI-compatible fallback for the Python content pipeline.
# Set all three values to enable it.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=180

PEXELS_API_KEY=

# Local GPU cinematic video rendering (Wan2.1; no video-generation API).
# Requires a CUDA GPU with at least 24 GiB FREE VRAM for the 14B profile.
AI_VIDEO_ENGINE=wan
WAN_QUALITY_PROFILE=cinematic
WAN_MODEL_ID=Wan-AI/Wan2.1-T2V-14B-Diffusers
WAN_STYLE_PROFILE=reference_dark_fantasy
WAN_INFERENCE_STEPS=32
WAN_SEED=110
WAN_WIDTH=576
WAN_HEIGHT=1024
CUDA_VISIBLE_DEVICES=0
# Optional: keep Hugging Face weights on a persistent disk between runs.
# HF_HOME=/data/huggingface

# YouTube Shorts final export.
SHORTS_WIDTH=1080
SHORTS_HEIGHT=1920
SHORTS_FPS=30
SHORTS_CRF=18

# Offline TTS is the default and does not call a speech API.
# Options: piper (recommended), edge-tts, elevenlabs.
TTS_PROVIDER=piper
PIPER_MODEL_DIR=models/piper
# Subtle close-mic + hall tail matching the supplied reference. Empty disables it.
PIPER_AUDIO_FILTER=highpass=f=70,lowpass=f=12000,aecho=0.80:0.72:85|170|255:0.10|0.06|0.03,loudnorm=I=-16:TP=-1.5:LRA=11
TTS_VOICE=fa_IR-mana-medium.onnx
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v4
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.75

# YouTube OAuth for publishing and channel operations
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Optional automatic comment moderation: bounded and safety-filtered.
ENABLE_AUTO_COMMENT_REPLIES=false
MAX_COMMENT_VIDEOS=1
MAX_COMMENTS_PER_VIDEO=3
