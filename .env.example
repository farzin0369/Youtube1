# Text generation providers are tried in order:
#   1. Groq free tier   2. any OpenAI-compatible gateway   3. local Ollama
# A failure in an earlier provider only falls through to the next one.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional OpenAI-compatible gateway (OpenRouter, Together, DeepInfra, local vLLM, ...)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=180

PEXELS_API_KEY=

# Local self-hosted language model (no paid LLM API required)
AI_ENGINE=local
LOCAL_LLM_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Fixed Persian neural voice (Edge TTS community client; no paid key).
TTS_PROVIDER=edge
TTS_VOICE=fa-IR-FaridNeural
PIPER_MODEL=

# YouTube OAuth for publishing and channel operations
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
