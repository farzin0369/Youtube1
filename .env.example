# Text generation providers are tried in order:
#   1. Groq free tier   2. any OpenAI-compatible gateway   3. local Ollama
# A failure in an earlier provider only falls through to the next one.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional OpenAI-compatible gateway (OpenRouter, Together, DeepInfra, local vLLM, ...)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=180

PEXELS_API_KEY=

# Local self-hosted language model (no paid LLM API required)
AI_ENGINE=local
LOCAL_LLM_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# TTS provider: edge / edge-tts (default), or elevenlabs.
# Set REQUIRE_OWNER_VOICE=true to fail closed unless ElevenLabs uses your enrolled/cloned voice.
TTS_PROVIDER=edge-tts
REQUIRE_OWNER_VOICE=false
TTS_VOICE=fa-IR-FaridNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v4
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.75
PIPER_MODEL=

# YouTube OAuth for publishing and channel operations
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Optional Figma Weave scene-image provider (official API requires Weave Enterprise).
# Keep disabled until a published compatible tool, token, and credit cap are configured.
WEAVE_API_TOKEN=
WEAVE_TOOL_ID=
WEAVE_AUTO_RUN=false
WEAVE_MAX_CREDIT_COST=0
WEAVE_POLL_TIMEOUT_SECONDS=600
WEAVE_POLL_INTERVAL_SECONDS=5
