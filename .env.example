# Optional free-tier Groq API; local Ollama remains the no-subscription fallback.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
PEXELS_API_KEY=

# Local self-hosted language model (no paid LLM API required)
AI_ENGINE=local
LOCAL_LLM_MODEL=llama3.2:1b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Fixed Persian neural voice (Edge TTS community client; no paid key).
TTS_PROVIDER=edge
TTS_VOICE=fa-IR-FaridNeural
PIPER_MODEL=

# YouTube OAuth for publishing and channel operations
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
