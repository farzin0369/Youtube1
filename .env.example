# Text generation providers are tried in order:
#   1. OpenRouter (if configured)   2. Groq   3. generic OpenAI-compatible gateway   4. local Ollama
# A failure in an earlier provider only falls through to the next one.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=minimax/minimax-m3.1-flash:free

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional OpenAI-compatible gateway (OpenRouter, Together, DeepInfra, local vLLM, ...)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=180

PEXELS_API_KEY=

# Local self-hosted language model (no paid LLM API required)
AI_ENGINE=local
LOCAL_LLM_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# TTS provider: edge / edge-tts (default), or elevenlabs. ElevenLabs needs an API key and voice ID.
TTS_PROVIDER=edge-tts
TTS_VOICE=fa-IR-FaridNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v4
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.75
PIPER_MODEL=

# YouTube OAuth for publishing and channel operations
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
