{
  "name": "ImamAli110 — safe video draft intake",
  "nodes": [
    {
      "parameters": {},
      "id": "b10b4d6a-7c11-4a5a-a001-000000000001",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Safe intake validator. No network calls, credentials, uploads, or publishing.\nconst items = $input.all();\nconst seen = new Set();\nreturn items.map((item, index) => {\n  const d = item.json ?? {};\n  const title = typeof d.title === 'string' ? d.title.trim() : '';\n  const topic = typeof d.topic === 'string' ? d.topic.trim().toLowerCase() : '';\n  const videoId = typeof d.videoId === 'string' ? d.videoId.trim() : '';\n  const priorIds = Array.isArray(d.existingVideoIds) ? d.existingVideoIds : [];\n  const priorTopics = Array.isArray(d.topicHistory) ? d.topicHistory.map(x => String(x).trim().toLowerCase()) : [];\n  const problems = [];\n  if (!title) problems.push('title_required');\n  if (!topic) problems.push('topic_required');\n  if (title.length > 100) problems.push('title_too_long');\n  if (videoId && priorIds.includes(videoId)) problems.push('duplicate_video_id');\n  if (topic && priorTopics.includes(topic)) problems.push('duplicate_topic_history');\n  const key = topic || title.toLowerCase();\n  if (key && seen.has(key)) problems.push('duplicate_in_batch');\n  if (key) seen.add(key);\n  return {json:{index, title, topic, videoId: videoId || null, valid: problems.length === 0, status: problems.length === 0 ? 'DRAFT_READY_FOR_REVIEW' : 'REJECTED', problems, uploadEnabled:false, publishEnabled:false}};\n});"
      },
      "id": "b10b4d6a-7c11-4a5a-a001-000000000002",
      "name": "Validate and deduplicate",
